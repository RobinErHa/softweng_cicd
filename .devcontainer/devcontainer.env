# Address of the host running JLinkRemoteServerCL, as seen from the container.
# Must be a literal IP: the J-Link client does not resolve host.docker.internal.
# Plain Docker on Linux: 172.17.0.1 (default docker bridge gateway).
# Docker Desktop: 192.168.65.254
PICO_SEGGER_IP=172.17.0.1
# PICO_SEGGER_IP=tunnel:801012091

# J-Link installation inside the DevContainer (used by launch.json 'serverpath')
PICO_JLINK_PATH=/opt/SEGGER/JLink

# GNU Arm Embedded toolchain inside the DevContainer (used by launch.json 'armToolchainPath')
PICO_TOOLCHAIN_PATH=/opt/gcc-arm-none-eabi-13.2.1-1.1/bin
